#!/bin/bash
#
# Pre-commit hook for SystemEQ for Mac
# Formats staged Swift files, then verifies them with the same gates CI runs.
#
# Every path in this project contains spaces ("SystemEQ for Mac/Audio/..."), so
# the staged list must be read NUL-delimited. The previous version iterated an
# unquoted variable, which split each path on whitespace into fragments that
# matched no file — SwiftFormat and SwiftLint were never invoked on anything,
# and the hook reported success on every commit.

set -uo pipefail

echo "🔍 Running pre-commit checks..."

echo "🧹 Checking staged diff for whitespace errors..."
if ! git diff --cached --check; then
    echo "❌ Staged diff contains whitespace errors."
    exit 1
fi
echo "✅ Staged diff clean"

STAGED_PATHS=$(mktemp "${TMPDIR:-/tmp}/systemeq-staged.XXXXXX") || exit 1
trap 'rm -f -- "$STAGED_PATHS"' EXIT
if ! git diff --cached --no-renames --name-only --diff-filter=ACMT -z -- '*.py' '*.swift' >"$STAGED_PATHS"; then
    echo "❌ Could not read staged paths." >&2
    exit 1
fi

PYTHON_FILES=()
while IFS= read -r -d '' file; do
    case "$file" in
        *.py) PYTHON_FILES+=("$file") ;;
    esac
done <"$STAGED_PATHS"

if [ ${#PYTHON_FILES[@]} -gt 0 ]; then
    echo "🐍 Compiling ${#PYTHON_FILES[@]} staged Python file(s)..."
    if ! python3 - "${PYTHON_FILES[@]}" <<'PYTHON'
import subprocess
import sys

failed = False
for path in sys.argv[1:]:
    try:
        source = subprocess.run(
            ["git", "show", ":" + path], check=True, stdout=subprocess.PIPE
        ).stdout
        compile(source, path, "exec", dont_inherit=True)
    except (subprocess.CalledProcessError, SyntaxError, ValueError) as error:
        print(f"{path}: {error}", file=sys.stderr)
        failed = True
sys.exit(1 if failed else 0)
PYTHON
    then
        echo "❌ Python syntax check failed."
        exit 1
    fi
    echo "✅ Python syntax clean"
fi

# Must match `excluded` in .swiftlint.yml and `--exclude` in .swiftformat,
# otherwise the hook blocks commits that CI would accept.
EXCLUDED_DIRS=(.build DerivedData .swiftpm Pods Carthage Scripts)

is_excluded() {
    local path="$1" dir
    for dir in "${EXCLUDED_DIRS[@]}"; do
        case "$path" in
            "$dir"/*) return 0 ;;
        esac
    done
    return 1
}

FILES=()
while IFS= read -r -d '' file; do
    case "$file" in
        *.swift) ;;
        *) continue ;;
    esac
    is_excluded "$file" && continue
    FILES+=("./$file")
done <"$STAGED_PATHS"

if [ ${#FILES[@]} -eq 0 ]; then
    echo "✅ No Swift files to check"
    echo "✅ All pre-commit checks passed!"
    exit 0
fi

echo "📝 Checking ${#FILES[@]} Swift file(s)..."

git --literal-pathspecs diff --quiet --no-ext-diff -- "${FILES[@]}"
diff_status=$?
case "$diff_status" in
    0) ;;
    1)
        echo "❌ Staged files also contain unstaged Swift edits. Resolve the split before automatic formatting." >&2
        exit 1
        ;;
    *)
        echo "❌ Could not compare staged Swift files with the working tree." >&2
        exit 1
        ;;
esac

for file in "${FILES[@]}"; do
    if [ ! -f "$file" ] || [ -L "$file" ]; then
        echo "❌ Expected a regular Swift file: $file" >&2
        exit 1
    fi
done

SKIPPED=0
FORMATTED=0

if command -v swiftformat &>/dev/null; then
    echo "🎨 Running SwiftFormat..."
    if ! FORMAT_OUTPUT=$(swiftformat "${FILES[@]}" --config .swiftformat 2>&1); then
        printf '%s\n' "$FORMAT_OUTPUT" >&2
        exit 1
    fi

    if ! FORMAT_OUTPUT=$(swiftformat "${FILES[@]}" --config .swiftformat --lint 2>&1); then
        echo "❌ SwiftFormat: files still fail --lint after formatting:"
        printf '%s\n' "$FORMAT_OUTPUT" >&2
        exit 1
    fi
    FORMATTED=1
    echo "✅ SwiftFormat clean"
else
    echo "⚠️  SwiftFormat NOT INSTALLED — formatting was NOT checked (brew install swiftformat)"
    SKIPPED=1
fi

if command -v swiftlint &>/dev/null; then
    echo "🔎 Running SwiftLint..."
    LINT_OUTPUT=$(swiftlint lint --config .swiftlint.yml --quiet "${FILES[@]}" 2>&1)
    LINT_STATUS=$?
    ERRORS=$(printf '%s\n' "$LINT_OUTPUT" | grep -c "error:")

    if [ "$LINT_STATUS" -ne 0 ] || [ "$ERRORS" -gt 0 ]; then
        printf '%s\n' "$LINT_OUTPUT" >&2
        echo "❌ SwiftLint found $ERRORS error(s). Fix before committing (swiftlint --fix may help)."
        exit 1
    fi
    echo "✅ SwiftLint passed"
else
    echo "⚠️  SwiftLint NOT INSTALLED — linting was NOT checked (brew install swiftlint)"
    SKIPPED=1
fi

if [ "$FORMATTED" -eq 1 ]; then
    if ! git --literal-pathspecs diff --check -- "${FILES[@]}" ||
        ! git --literal-pathspecs add -- "${FILES[@]}"; then
        echo "❌ Could not stage the formatted Swift files." >&2
        exit 1
    fi
fi

if [ "$SKIPPED" -eq 1 ]; then
    echo "⚠️  Some checks were SKIPPED — CI may still reject this commit."
    exit 0
fi

echo "✅ All pre-commit checks passed!"
exit 0
